# Ignore git files
.git
.gitignore

# Ignore documentation and readme files
*.md
README*
docs/

# Ignore Docker files
docker-compose.yml
Dockerfile*

# Ignore node_modules from all directories
**/node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore build outputs
**/dist/
**/build/
**/.next/
**/out/

# Ignore cache directories
**/.cache/
**/tmp/
**/temp/

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore log files
*.log
**/logs/

# Ignore environment files (keep them local)
.env
.env.*
!.env.example

# Ignore vendor directories
**/vendor/

# Ignore compiled files
*.class
*.o
*.so
*.pyc
__pycache__/

# Ignore test files and coverage reports
**/coverage/
**/test-results/
**/tests/
**/*.test.js
**/*.spec.js

# Ignore package manager files
package-lock.json
yarn.lock
composer.lock

# Ignore large media files
*.zip
*.tar.gz
*.rar
*.7z
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.ico
*.pdf

# Ignore backup files
*.bak
*.backup
*.old

# Ignore development databases
*.sqlite
*.db
