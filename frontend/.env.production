# Next.js Production Environment Configuration

# API Configuration
NEXT_PUBLIC_API_URL=https://your-production-domain.com/api
NEXT_PUBLIC_API_BASE_URL=https://your-production-domain.com
NEXT_PUBLIC_FRONTEND_URL=https://your-production-domain.com

# Application Configuration
NEXT_PUBLIC_APP_NAME="Projeto Integrador"
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_DEBUG=false

# Database API Endpoints
NEXT_PUBLIC_USERS_API_ENDPOINT=/users
NEXT_PUBLIC_PROJECTS_API_ENDPOINT=/projects
NEXT_PUBLIC_TASKS_API_ENDPOINT=/tasks
NEXT_PUBLIC_REPORTS_API_ENDPOINT=/reports

# Authentication
NEXT_PUBLIC_AUTH_ENDPOINT=/auth
NEXT_PUBLIC_LOGIN_ENDPOINT=/auth/login
NEXT_PUBLIC_LOGOUT_ENDPOINT=/auth/logout
NEXT_PUBLIC_REGISTER_ENDPOINT=/auth/register

# File Upload
NEXT_PUBLIC_UPLOAD_ENDPOINT=/upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# Production specific variables (not prefixed with NEXT_PUBLIC_)
DATABASE_URL=mysql://root:secure_production_password@mysql:3306/projeto_integrador_prod
NEXTAUTH_SECRET=your_very_secure_production_secret_key_here
NEXTAUTH_URL=https://your-production-domain.com

# Analytics and Monitoring (example variables)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXX-X
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
