# Next.js Environment Variables Example
# Copy this file to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_NAME="Projeto Integrador"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_DEBUG=true

# Database API Endpoints
NEXT_PUBLIC_USERS_API_ENDPOINT=/users
NEXT_PUBLIC_PROJECTS_API_ENDPOINT=/projects
NEXT_PUBLIC_TASKS_API_ENDPOINT=/tasks
NEXT_PUBLIC_REPORTS_API_ENDPOINT=/reports

# Authentication
NEXT_PUBLIC_AUTH_ENDPOINT=/auth
NEXT_PUBLIC_LOGIN_ENDPOINT=/auth/login
NEXT_PUBLIC_LOGOUT_ENDPOINT=/auth/logout
NEXT_PUBLIC_REGISTER_ENDPOINT=/auth/register

# File Upload
NEXT_PUBLIC_UPLOAD_ENDPOINT=/upload
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# Server-side only variables (not prefixed with NEXT_PUBLIC_)
DATABASE_URL=mysql://username:password@host:port/database
NEXTAUTH_SECRET=your_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Optional: Analytics and Monitoring
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
